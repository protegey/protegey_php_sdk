{
  "name": "protegey/sdk",
  "description": "Official Protegey SDK for PHP backends — transaction reporting, identity verification sessions, and webhook signature verification.",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "guzzlehttp/guzzle": "^7.8 || ^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Protegey\\Sdk\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Protegey\\Sdk\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
